<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>$(KCCPackageVersion)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyName>KerbalismCompanionCalculator</AssemblyName>
    <RootNamespace>KerbalismCompanionCalculator</RootNamespace>
    <TargetFramework>net481</TargetFramework>

    <Description>Antenna planner companion for Kerbalism (stock CommNet).</Description>
    <Product>KerbalismCompanionCalculator</Product>
    <ComVisible>false</ComVisible>

    <KSPBT_ModRoot>$(ProjectRootDir)GameData\KerbalismCompanionCalculator</KSPBT_ModRoot>
    <KSPBT_ModPluginFolder>Plugin</KSPBT_ModPluginFolder>
    <KCC_DeployToKsp Condition=" '$(KCC_DeployToKsp)' == '' ">false</KCC_DeployToKsp>

    <LangVersion>latest</LangVersion>
    <DebugType>portable</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(KSPBT_ModVersion)' != '' ">
    <Version>$(KSPBT_ModVersion)</Version>
    <FileVersion>$(Version)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Properties/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="KSPBuildTools" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ModReference Include="Kerbalism">
      <DLLPath>GameData/Kerbalism/Kerbalism.dll</DLLPath>
      <CKANIdentifier>Kerbalism</CKANIdentifier>
      <KSPAssemblyVersion>0.0</KSPAssemblyVersion>
    </ModReference>
  </ItemGroup>

  <ItemGroup>
    <KSPVersionFile Include=".">
      <Destination>$(KSPBT_ModRoot)/KerbalismCompanionCalculator.version</Destination>
      <URL>https://raw.githubusercontent.com/Aebestach/KerbalismCompanionCalculator/master/GameData/KerbalismCompanionCalculator/KerbalismCompanionCalculator.version</URL>
      <Download>https://github.com/Aebestach/KerbalismCompanionCalculator/releases</Download>
      <KSP_Version>1.12.5</KSP_Version>
      <KSP_Version_Min>1.12.0</KSP_Version_Min>
      <KSP_Version_Max>1.12.99</KSP_Version_Max>
    </KSPVersionFile>
  </ItemGroup>

  <Target Name="DeployGameDataToKsp" AfterTargets="KSPBT_CopyDLLsToPluginFolder"
          Condition=" '$(KCC_DeployToKsp)' == 'true' And '$(KSPBT_GameRoot)' != '' ">
    <PropertyGroup>
      <_KspKCCDeployDir>$(KSPBT_GameRoot)/GameData/KerbalismCompanionCalculator</_KspKCCDeployDir>
    </PropertyGroup>
    <ItemGroup>
      <_KCCDeployFiles Include="$(KSPBT_ModRoot)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_KCCDeployFiles)" DestinationFolder="$(_KspKCCDeployDir)/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Message Text="Deployed GameData/KerbalismCompanionCalculator to $(KSPBT_GameRoot)" Importance="high" />
  </Target>
</Project>
